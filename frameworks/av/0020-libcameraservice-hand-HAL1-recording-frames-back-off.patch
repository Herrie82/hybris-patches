@@ -183,6 +189,24 @@ private:
     void                            disconnectVideoWindow();
     void                            copyFrameToVideoWindow(nsecs_t timestamp, const sp<IMemory>& dataPtr);
 
+    // Buffer-queue recording frames go back to the HAL from this thread, never from inside the
+    // HAL's data callback. The callback is a HIDL call from the provider's callback thread, so a
+    // release made inside it is a nested call that binder runs on that same provider thread - and
+    // on QCamera2 (msm8916) stopRecording() holds the HIDL CameraDevice's lock while it joins that
+    // thread, so the nested release waited for the lock and the join waited for the release.
+    // Queued here, the callback returns at once, the join completes and the release follows.
+    std::mutex                      mFrameReleaseLock;  // guards the three below
+    std::condition_variable         mFrameReleaseCond;
+    std::deque<std::pair<sp<CameraHardwareInterface>, sp<IMemory>>> mFrameReleaseQueue;
+    bool                            mFrameReleaseStop = false;
+    std::thread                     mFrameReleaseThread; // started on the first frame, see below
+    void                            queueRecordingFrameRelease(
+                                            const sp<CameraHardwareInterface>& hardware,
+                                            const sp<IMemory>& dataPtr);
+    void                            frameReleaseLoop();
+    // Releases what is queued, then ends the thread. Called before mHardware->release().
+    void                            stopFrameReleaseThread();
+
     // If the user want us to return a copy of the preview frame (instead
     // of the original one), we allocate mPreviewBuffer and reuse it if possible.
     sp<MemoryHeapBase>              mPreviewBuffer;
