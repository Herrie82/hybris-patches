@@ -275,6 +280,8 @@ binder::Status CameraClient::disconnect() {
     mHardware->stopPreview();
     finishCameraStreamingOps();
     mHardware->cancelPicture();
+    // Hand back any recording frames still queued while the device is open.
+    stopFrameReleaseThread();
     // Release the hardware resources.
     mHardware->release();
 
@@ -1110,11 +1117,23 @@ void CameraClient::handleGenericData(int32_t msgType,
 void CameraClient::handleGenericDataTimestamp(nsecs_t timestamp,
     int32_t msgType, const sp<IMemory>& dataPtr) {
     sp<hardware::ICameraClient> c = mRemoteCallback;
+    // Taken while mLock is still held, because the buffer-queue branch below
+    // must not take mLock again. It runs on the HAL's callback thread, and
+    // stopRecording() holds mLock across mHardware->stopRecording(), which on
+    // QCamera2 (msm8916) joins exactly that thread: QCameraChannel::stop() ->
+    // QCameraCmdThread::exit() -> pthread_join. Re-taking mLock here to release
+    // the frame deadlocked the two for good, with the camera wedged until
+    // minimediaservice restarted. The reference keeps the interface alive past
+    // a concurrent disconnect(); the HAL joins this thread before close().
+    // The release itself is queued rather than made here: see
+    // mFrameReleaseThread in CameraClient.h for the second deadlock that a
+    // release from inside this callback caused.
+    const bool bufferQueueMode = mVideoBufferQueueMode;
+    const sp<CameraHardwareInterface> hardware = mHardware;
     mLock.unlock();
-    if (msgType == CAMERA_MSG_VIDEO_FRAME && mVideoBufferQueueMode && dataPtr != nullptr) {
+    if (msgType == CAMERA_MSG_VIDEO_FRAME && bufferQueueMode && dataPtr != nullptr) {
         copyFrameToVideoWindow(timestamp, dataPtr);
-        Mutex::Autolock l(mLock);
-        if (mHardware != 0) mHardware->releaseRecordingFrame(dataPtr);
+        if (hardware != 0) queueRecordingFrameRelease(hardware, dataPtr);
         return;
     }
     if (c != 0 && dataPtr != nullptr) {
@@ -1272,6 +1291,49 @@ status_t CameraClient::setVideoTarget(const sp<SurfaceType>& target) {
     return NO_ERROR;
 }
 
+void CameraClient::queueRecordingFrameRelease(const sp<CameraHardwareInterface>& hardware,
+        const sp<IMemory>& dataPtr) {
+    const std::lock_guard<std::mutex> l(mFrameReleaseLock);
+    if (mFrameReleaseStop) {
+        // Only after disconnect() began: the HAL is about to free its buffers anyway.
+        ALOGW("%s: recording frame after the device was released, not returned", __FUNCTION__);
+        return;
+    }
+    if (!mFrameReleaseThread.joinable()) {
+        mFrameReleaseThread = std::thread(&CameraClient::frameReleaseLoop, this);
+    }
+    mFrameReleaseQueue.emplace_back(hardware, dataPtr);
+    mFrameReleaseCond.notify_one();
+}
+
+void CameraClient::frameReleaseLoop() {
+    pthread_setname_np(pthread_self(), "CamFrameRelease");
+    std::unique_lock<std::mutex> l(mFrameReleaseLock);
+    for (;;) {
+        mFrameReleaseCond.wait(l, [this] {
+            return mFrameReleaseStop || !mFrameReleaseQueue.empty();
+        });
+        // Stopping still hands back everything that was queued first.
+        if (mFrameReleaseQueue.empty()) return;
+        std::pair<sp<CameraHardwareInterface>, sp<IMemory>> frame =
+                std::move(mFrameReleaseQueue.front());
+        mFrameReleaseQueue.pop_front();
+        l.unlock();
+        frame.first->releaseRecordingFrame(frame.second);
+        frame = {};  // drop the references outside the lock
+        l.lock();
+    }
+}
+
+void CameraClient::stopFrameReleaseThread() {
+    {
+        const std::lock_guard<std::mutex> l(mFrameReleaseLock);
+        mFrameReleaseStop = true;
+    }
+    mFrameReleaseCond.notify_all();
+    if (mFrameReleaseThread.joinable()) mFrameReleaseThread.join();
+}
+
 void CameraClient::disconnectVideoWindow() {
     Mutex::Autolock l(mVideoWindowLock);
     if (mVideoWindow != 0) {
