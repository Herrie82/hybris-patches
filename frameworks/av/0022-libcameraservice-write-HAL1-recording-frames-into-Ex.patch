diff --git a/services/camera/libcameraservice/tests/ExynosVideoBufferTest.cpp b/services/camera/libcameraservice/tests/ExynosVideoBufferTest.cpp
new file mode 100644
index 0000000000..0a15d33bb8
--- /dev/null
+++ b/services/camera/libcameraservice/tests/ExynosVideoBufferTest.cpp
@@ -0,0 +1,156 @@
+/*
+ * Copyright (C) 2026 Herman van Hazendonk <github.com@herrie.org>
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <cstring>
+#include <vector>
+
+#include <android-base/file.h>
+#include <gtest/gtest.h>
+
+#include "../api1/ExynosVideoBuffer.h"
+
+using namespace android::exynos_video_buffer;
+
+namespace {
+
+// A native_handle_t laid out as the Exynos gralloc's private_handle_t for a two-plane buffer.
+struct FakeHandle {
+    native_handle_t h;
+    int data[16];
+};
+
+class ExynosVideoBufferTest : public ::testing::Test {
+  protected:
+    static constexpr int kW = 64, kH = 36, kStride = 80, kVstride = 48;
+
+    void SetUp() override {
+        yFd = yFile.release();
+        cFd = cFile.release();
+        ASSERT_GE(yFd, 0);
+        ASSERT_GE(cFd, 0);
+        ySize = static_cast<size_t>(kStride) * kVstride + 256;
+        cSize = static_cast<size_t>(kStride) * 24 + 256;
+        ASSERT_EQ(0, ftruncate(yFd, static_cast<off_t>(ySize)));
+        ASSERT_EQ(0, ftruncate(cFd, static_cast<off_t>(cSize)));
+        memset(&fh, 0, sizeof(fh));
+        fh.h.version = sizeof(native_handle_t);
+        fh.h.numFds = 2;
+        fh.h.numInts = 14;
+        d = fh.h.data;  // through a pointer: data[] is a zero-length array
+        d[0] = yFd;
+        d[1] = cFd;
+        d[2] = -1;
+        d[3] = kMagic;
+        d[7] = kFormatYCrCb420SpM;
+        d[8] = kW;
+        d[9] = kH;
+        d[10] = kStride;
+        d[11] = kVstride;
+    }
+    void TearDown() override {
+        close(yFd);
+        close(cFd);
+    }
+    std::vector<uint8_t> readFd(int fd, size_t size) {
+        std::vector<uint8_t> v(size);
+        EXPECT_EQ(static_cast<ssize_t>(size), pread(fd, v.data(), size, 0));
+        return v;
+    }
+
+    TemporaryFile yFile, cFile;
+    FakeHandle fh;
+    int* d = nullptr;
+    int yFd = -1, cFd = -1;
+    size_t ySize = 0, cSize = 0;
+};
+
+TEST_F(ExynosVideoBufferTest, ParsesTheExynosHandle) {
+    Planes p{};
+    ASSERT_TRUE(parse(&fh.h, kW, kH, &p));
+    EXPECT_EQ(yFd, p.yFd);
+    EXPECT_EQ(cFd, p.cFd);
+    EXPECT_EQ(kStride, p.stride);
+    EXPECT_EQ(kVstride, p.vstride);
+}
+
+TEST_F(ExynosVideoBufferTest, RejectsOtherHandles) {
+    Planes p{};
+    EXPECT_FALSE(parse(nullptr, kW, kH, &p));
+    EXPECT_FALSE(parse(&fh.h, kW, kH, nullptr));
+    EXPECT_FALSE(parse(&fh.h, kW + 2, kH, &p));     // other size
+    EXPECT_FALSE(parse(&fh.h, kW, kH + 2, &p));
+    EXPECT_FALSE(parse(&fh.h, kW + 1, kH, &p));     // odd size
+    d[3] = 0;                               // other magic
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    d[3] = kMagic;
+    d[7] = 0x11;                            // single-plane NV21
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    d[7] = kFormatYCrCb420SpM;
+    fh.h.numFds = 1;                                // one plane
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    fh.h.numFds = 2;
+    fh.h.numInts = 9;                               // too short to hold vstride
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    fh.h.numInts = 14;
+    d[10] = kW - 2;                         // stride below width
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    d[10] = 100000;                         // absurd stride
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    d[10] = kStride;
+    d[11] = kH - 2;                         // vstride below height
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    d[11] = kVstride;
+    d[1] = -1;                              // no chroma fd
+    EXPECT_FALSE(parse(&fh.h, kW, kH, &p));
+    d[1] = cFd;
+    EXPECT_TRUE(parse(&fh.h, kW, kH, &p));
+}
+
+TEST_F(ExynosVideoBufferTest, WritesNv21RowsAtTheStride) {
+    std::vector<uint8_t> src(static_cast<size_t>(kW) * kH * 3 / 2);
+    for (size_t i = 0; i < src.size(); i++) src[i] = static_cast<uint8_t>(i * 7 + 3);
+    Planes p{};
+    ASSERT_TRUE(parse(&fh.h, kW, kH, &p));
+    ASSERT_EQ(0, writeNv21(p, kW, kH, src.data()));
+
+    const std::vector<uint8_t> y = readFd(yFd, ySize);
+    const std::vector<uint8_t> c = readFd(cFd, cSize);
+    for (int row = 0; row < kH; row++) {
+        ASSERT_EQ(0, memcmp(&y[row * kStride], &src[row * kW], kW)) << "Y row " << row;
+        for (int x = kW; x < kStride; x++) ASSERT_EQ(0, y[row * kStride + x]) << "Y padding";
+    }
+    for (size_t i = static_cast<size_t>(kH) * kStride; i < ySize; i++) ASSERT_EQ(0, y[i]);
+    const uint8_t* vu = &src[static_cast<size_t>(kW) * kH];
+    for (int row = 0; row < kH / 2; row++) {
+        ASSERT_EQ(0, memcmp(&c[row * kStride], &vu[row * kW], kW)) << "VU row " << row;
+        for (int x = kW; x < kStride; x++) ASSERT_EQ(0, c[row * kStride + x]) << "VU padding";
+    }
+    for (size_t i = static_cast<size_t>(kH / 2) * kStride; i < cSize; i++) ASSERT_EQ(0, c[i]);
+}
+
+TEST_F(ExynosVideoBufferTest, WriteFailsCleanly) {
+    std::vector<uint8_t> src(static_cast<size_t>(kW) * kH * 3 / 2);
+    Planes p{yFd, cFd, kStride, kVstride};
+    EXPECT_EQ(-EINVAL, writeNv21(p, kW, kH, nullptr));
+    EXPECT_EQ(-EINVAL, writeNv21(Planes{yFd, cFd, kW - 2, kVstride}, kW, kH, src.data()));
+    EXPECT_LT(writeNv21(Planes{-1, cFd, kStride, kVstride}, kW, kH, src.data()), 0);
+    EXPECT_LT(writeNv21(Planes{yFd, -1, kStride, kVstride}, kW, kH, src.data()), 0);
+}
+
+}  // namespace
