+#ifndef ANDROID_SERVERS_CAMERA_EXYNOS_VIDEO_BUFFER_H
+#define ANDROID_SERVERS_CAMERA_EXYNOS_VIDEO_BUFFER_H
+
+#include <stdint.h>
+
+#include <cutils/native_handle.h>
+
+namespace android {
+namespace exynos_video_buffer {
+
+// The Samsung Exynos gralloc (hardware/samsung_slsi/exynos/gralloc) hands the video encoder
+// HAL_PIXEL_FORMAT_EXYNOS_YCrCb_420_SP_M buffers: two ion buffers, the Y plane in the first and the
+// interleaved Cr/Cb plane in the second, rows of `stride` bytes. Its lock_ycbcr() refuses that
+// format and its lock() writes a second plane pointer the 16.0 mapper has no room for, so neither
+// gives the CPU a way in.
+//
+// Layout of its private_handle_t as seen through native_handle_t::data[]: three fds (fd, fd1, fd2;
+// fd2 is -1 and counted as an int when there are two planes), then magic, flags, size, offset,
+// format, width, height, stride, vstride.
+constexpr int kMagic = 0x3141592;
+constexpr int kFormatYCrCb420SpM = 0x11D;  // HAL_PIXEL_FORMAT_EXYNOS_YCrCb_420_SP_M
+
+struct Planes {
+    int yFd;
+    int cFd;
+    int stride;   // bytes per row, both planes
+    int vstride;  // rows allocated in the Y plane
+};
+
+// Whether `handle` is such a buffer, `width` x `height`; fills `out` if so. Anything else, including
+// a handle of any other gralloc, is rejected without being written to.
+bool parse(const native_handle_t* handle, int width, int height, Planes* out);
+
+// Write one NV21 frame (Y plane of width * height bytes, then interleaved V/U rows of width bytes)
+// into the buffer's two planes. The planes are mapped for the copy only. Returns 0 or -errno.
+int writeNv21(const Planes& planes, int width, int height, const uint8_t* nv21);
+
+}  // namespace exynos_video_buffer
+}  // namespace android
+
+#endif  // ANDROID_SERVERS_CAMERA_EXYNOS_VIDEO_BUFFER_H
