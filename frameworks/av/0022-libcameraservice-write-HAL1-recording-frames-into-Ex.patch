+#include "ExynosVideoBuffer.h"
+
+#include <errno.h>
+#include <string.h>
+#include <sys/mman.h>
+
+namespace android {
+namespace exynos_video_buffer {
+
+namespace {
+
+// Indices into native_handle_t::data[] (see the header).
+enum : uint8_t {
+    kFd = 0,
+    kFd1 = 1,
+    kMagicIdx = 3,
+    kFormatIdx = 7,
+    kWidthIdx = 8,
+    kHeightIdx = 9,
+    kStrideIdx = 10,
+    kVstrideIdx = 11,
+    kMinSlots = 12,
+};
+
+constexpr int kMaxDimension = 8192;
+
+// The chroma plane holds vstride / 2 rows, rounded up to 8 as the gralloc allocates it; the copy
+// only touches the first height / 2 of them.
+size_t chromaRows(int vstride) {
+    return (static_cast<size_t>(vstride) / 2 + 7) & ~static_cast<size_t>(7);
+}
+
+}  // namespace
+
+bool parse(const native_handle_t* handle, int width, int height, Planes* out) {
+    if (handle == nullptr || out == nullptr || width <= 0 || height <= 0 ||
+            (width & 1) != 0 || (height & 1) != 0) {
+        return false;
+    }
+    if (handle->numFds != 2 || handle->numInts < 0 ||
+            handle->numFds + handle->numInts < kMinSlots) {
+        return false;
+    }
+    const int* d = handle->data;
+    if (d[kMagicIdx] != kMagic || d[kFormatIdx] != kFormatYCrCb420SpM ||
+            d[kWidthIdx] != width || d[kHeightIdx] != height) {
+        return false;
+    }
+    const int stride = d[kStrideIdx], vstride = d[kVstrideIdx];
+    if (stride < width || stride > kMaxDimension || vstride < height || vstride > kMaxDimension ||
+            d[kFd] < 0 || d[kFd1] < 0) {
+        return false;
+    }
+    *out = Planes{d[kFd], d[kFd1], stride, vstride};
+    return true;
+}
+
+int writeNv21(const Planes& planes, int width, int height, const uint8_t* nv21) {
+    if (nv21 == nullptr || width <= 0 || height <= 0 || planes.stride < width || planes.vstride < height) {
+        return -EINVAL;
+    }
+    const size_t stride = static_cast<size_t>(planes.stride);
+    const size_t ySize = stride * static_cast<size_t>(planes.vstride);
+    const size_t cSize = stride * chromaRows(planes.vstride);
+
+    void* y = mmap(nullptr, ySize, PROT_WRITE, MAP_SHARED, planes.yFd, 0);
+    if (y == MAP_FAILED) return -errno;
+    void* c = mmap(nullptr, cSize, PROT_WRITE, MAP_SHARED, planes.cFd, 0);
+    if (c == MAP_FAILED) {
+        const int err = errno;
+        munmap(y, ySize);
+        return -err;
+    }
+
+    const size_t w = static_cast<size_t>(width);
+    uint8_t* dy = static_cast<uint8_t*>(y);
+    for (int row = 0; row < height; row++) {
+        memcpy(dy + row * stride, nv21 + row * w, w);
+    }
+    // Both NV21 and YCrCb_420_SP_M interleave V before U: rows copy as they are.
+    const uint8_t* vu = nv21 + w * static_cast<size_t>(height);
+    uint8_t* dc = static_cast<uint8_t*>(c);
+    for (int row = 0; row < height / 2; row++) {
+        memcpy(dc + row * stride, vu + row * w, w);
+    }
+
+    munmap(c, cSize);
+    munmap(y, ySize);
+    return 0;
+}
+
+}  // namespace exynos_video_buffer
+}  // namespace android
