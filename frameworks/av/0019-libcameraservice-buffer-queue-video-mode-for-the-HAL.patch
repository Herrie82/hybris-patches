 status_t CameraClient::setVideoTarget(const sp<SurfaceType>& target) {
-    (void)target;
-    ALOGE("%s: %d: CameraClient doesn't support setting a video target.", __FUNCTION__, __LINE__);
-    return INVALID_OPERATION;
+    LOG1("setVideoTarget(%p) (pid %d)", target.get(), getCallingPid());
+    Mutex::Autolock lock(mLock);
+    status_t res = checkPidAndHardware();
+    if (res != NO_ERROR) return res;
+
+    disconnectVideoWindow();
+    if (target == 0) return NO_ERROR;
+
+#if WB_LIBCAMERASERVICE_WITH_DEPENDENCIES
+    sp<IGraphicBufferProducer> bufferProducer = target->getIGraphicBufferProducer();
+#else
+    sp<IGraphicBufferProducer> bufferProducer = target;
+#endif
+    sp<ANativeWindow> window = new Surface(bufferProducer, /*controlledByApp*/ false);
+
+    CameraParameters params(mHardware->getParameters());
+    int width = -1, height = -1;
+    params.getVideoSize(&width, &height);
+    if (width <= 0 || height <= 0) params.getPreviewSize(&width, &height);
+    if (width <= 0 || height <= 0) {
+        ALOGE("%s: no video or preview size set", __FUNCTION__);
+        return BAD_VALUE;
+    }
+
+    res = native_window_api_connect(window.get(), NATIVE_WINDOW_API_CAMERA);
+    if (res != NO_ERROR) {
+        ALOGE("%s: connecting to the video target failed: %s (%d)", __FUNCTION__,
+                strerror(-res), res);
+        return res;
+    }
+    // The consumer (CameraSource) asks for HW_VIDEO_ENCODER usage with an implementation-defined
+    // format, from which gralloc picks the layout the device's encoder reads. The frames are written
+    // by the CPU and read by the encoder's DMA, so declare the writes as rare: gralloc then maps the
+    // buffers uncached, and nothing is left in the CPU cache when the encoder reads them (an unlock
+    // that does not clean the cache gave green frames on the HP TouchPad).
+    if ((res = native_window_set_buffers_dimensions(window.get(), width, height)) != NO_ERROR ||
+            (res = native_window_set_buffers_format(window.get(),
+                    HAL_PIXEL_FORMAT_IMPLEMENTATION_DEFINED)) != NO_ERROR ||
+            (res = native_window_set_usage(window.get(), GRALLOC_USAGE_SW_WRITE_RARELY)) != NO_ERROR) {
+        ALOGE("%s: configuring the video target failed: %s (%d)", __FUNCTION__,
+                strerror(-res), res);
+        native_window_api_disconnect(window.get(), NATIVE_WINDOW_API_CAMERA);
+        return res;
+    }
+
+    Mutex::Autolock l(mVideoWindowLock);
+    mVideoWindow = window;
+    mVideoWidth = width;
+    mVideoHeight = height;
+    LOG1("setVideoTarget: %dx%d", width, height);
+    return NO_ERROR;
+}
+
+void CameraClient::disconnectVideoWindow() {
+    Mutex::Autolock l(mVideoWindowLock);
+    if (mVideoWindow != 0) {
+        native_window_api_disconnect(mVideoWindow.get(), NATIVE_WINDOW_API_CAMERA);
+        mVideoWindow.clear();
+    }
+}
+
+// Copy one YUV 4:2:0 semi-planar recording frame of the HAL (NV21, the format of the camera HAL1
+// preview and video frames: Y plane, then interleaved V/U at width * height) into a buffer of the video
+// target, in whatever plane layout gralloc gave that buffer, and queue it with the frame's timestamp.
+void CameraClient::copyFrameToVideoWindow(nsecs_t timestamp, const sp<IMemory>& dataPtr) {
+    Mutex::Autolock l(mVideoWindowLock);
+    if (mVideoWindow == 0) return;
+
+    const int width = mVideoWidth, height = mVideoHeight;
+    const size_t frameSize = (size_t) width * height * 3 / 2;
+    // TODO: Using unsecurePointer() has some associated security pitfalls (see its declaration);
+    //       the frame comes from the HAL's own heap and is only read here, within its size.
+    const uint8_t* src = (const uint8_t*) dataPtr->unsecurePointer();
+    if (src == nullptr || dataPtr->size() < frameSize) {
+        ALOGE("%s: recording frame of %zu bytes is smaller than %dx%d", __FUNCTION__,
+                dataPtr->size(), width, height);
+        return;
+    }
+
+    ANativeWindowBuffer* anb = nullptr;
+    status_t res = native_window_dequeue_buffer_and_wait(mVideoWindow.get(), &anb);
+    if (res != NO_ERROR) {
+        ALOGE("%s: dequeueing a video buffer failed: %s (%d)", __FUNCTION__, strerror(-res), res);
+        return;
+    }
+
+    android_ycbcr ycbcr = {};
+    res = GraphicBufferMapper::get().lockYCbCr(anb->handle, GRALLOC_USAGE_SW_WRITE_RARELY,
+            Rect(width, height), &ycbcr);
+    if (res != NO_ERROR || ycbcr.y == nullptr || ycbcr.cb == nullptr || ycbcr.cr == nullptr) {
+        ALOGE("%s: locking a video buffer failed: %s (%d)", __FUNCTION__, strerror(-res), res);
+        mVideoWindow->cancelBuffer(mVideoWindow.get(), anb, -1);
+        return;
+    }
+
+    uint8_t* y = (uint8_t*) ycbcr.y;
+    for (int row = 0; row < height; row++)
+        memcpy(y + row * ycbcr.ystride, src + (size_t) row * width, width);
+
+    const uint8_t* vu = src + (size_t) width * height;
+    uint8_t* cb = (uint8_t*) ycbcr.cb;
+    uint8_t* cr = (uint8_t*) ycbcr.cr;
+    for (int row = 0; row < height / 2; row++) {
+        const uint8_t* s = vu + (size_t) row * width;
+        uint8_t* dcb = cb + row * ycbcr.cstride;
+        uint8_t* dcr = cr + row * ycbcr.cstride;
+        for (int x = 0; x < width / 2; x++) {
+            dcr[x * ycbcr.chroma_step] = s[2 * x];
+            dcb[x * ycbcr.chroma_step] = s[2 * x + 1];
+        }
+    }
+
+    GraphicBufferMapper::get().unlock(anb->handle);
+    native_window_set_buffers_timestamp(mVideoWindow.get(), timestamp);
+    res = mVideoWindow->queueBuffer(mVideoWindow.get(), anb, -1);
+    if (res != NO_ERROR) {
+        ALOGE("%s: queueing a video buffer failed: %s (%d)", __FUNCTION__, strerror(-res), res);
+    }
 }
 
