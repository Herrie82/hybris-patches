+    // A HAL without metadata support rejects the call even when asked to turn it off (the HP TouchPad's
+    // answers BAD_VALUE); off is what YUV frames need, so that is not an error.
+    if (!enableMetadataInBuffers && res != NO_ERROR) {
+        LOG1("setVideoBufferMode: HAL has no metadata mode (%d), using YUV frames", res);
+        res = NO_ERROR;
+    }
+    if (res == NO_ERROR) mVideoBufferQueueMode = bufferQueueMode;
+    return res;
