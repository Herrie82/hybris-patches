@@ -604,9 +612,13 @@ void CameraClient::releaseRecordingFrameHandleBatch(const std::vector<native_han
 status_t CameraClient::setVideoBufferMode(int32_t videoBufferMode) {
     LOG1("setVideoBufferMode: %d", videoBufferMode);
     bool enableMetadataInBuffers = false;
+    bool bufferQueueMode = false;
 
     if (videoBufferMode == VIDEO_BUFFER_MODE_DATA_CALLBACK_METADATA) {
         enableMetadataInBuffers = true;
+    } else if (videoBufferMode == VIDEO_BUFFER_MODE_BUFFER_QUEUE) {
+        // The HAL keeps sending YUV frames; handleGenericDataTimestamp() copies them to the target.
